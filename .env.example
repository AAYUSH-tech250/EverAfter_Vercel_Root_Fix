# Copy this file to ".env" for local use. On Vercel, add these in Project -> Settings -> Environment Variables.
SECRET_KEY=put-a-long-random-string-here
DEBUG=1
# Postgres connection string (Neon / Supabase / Vercel Postgres). Leave empty locally to use SQLite.
DATABASE_URL=
# Optional extras
# ALLOWED_HOSTS=wedding.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://wedding.yourdomain.com
# TIME_ZONE=Asia/Kolkata
# DEFAULT_COUNTRY_CODE=91
